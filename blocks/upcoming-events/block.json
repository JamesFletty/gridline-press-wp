{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gridline/upcoming-events",
	"version": "1.0.0",
	"title": "Upcoming events",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Lists the next gallery events (date today or later), soonest first. Rendered on the server.",
	"keywords": [ "events", "gallery", "calendar" ],
	"textdomain": "gridline",
	"attributes": {
		"count": { "type": "integer", "default": 3 },
		"heading": { "type": "string", "default": "Upcoming" }
	},
	"supports": { "html": false, "align": [ "wide", "full" ], "spacing": { "margin": true, "padding": true } },
	"editorScript": "file:./editor.js"
}
